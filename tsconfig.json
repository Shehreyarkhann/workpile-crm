{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "allowImportingTsExtensions": true, "noEmit": true, "skipLibCheck": true,
    "strict": false, "noImplicitAny": false, "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true, "jsx": "react",
    "types": ["node"]
  },
  "include": ["server/**/*.ts"]
}
